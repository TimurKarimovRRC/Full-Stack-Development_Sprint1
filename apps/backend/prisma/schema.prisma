generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestDifficulty {
  Easy
  Medium
  Hard
  Expert
}

model Quest {
  id          Int             @id @default(autoincrement())
  title       String
  location    String
  difficulty  QuestDifficulty
  description String
  reward      String
}
