{
  "name": "fantasy-quest-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:frontend": "npm run dev --workspace=@questboard/frontend",
    "start:backend": "npm run dev --workspace=@questboard/backend",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "build": "npm run build --workspace=@questboard/frontend && npm run build --workspace=@questboard/backend",
    "lint": "eslint apps shared",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
